<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+): las bases de datos locales no salen del dispositivo; los datos de la cuenta viven en Firebase. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
    </device-transfer>
</data-extraction-rules>
